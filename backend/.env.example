# 이 파일을 복사해서 backend/.env 로 만들고 값을 채운다. (.env는 Git에 올라가지 않음)
# Render에서는 같은 이름으로 Environment 탭에 입력한다.

# dev(내 컴퓨터) 또는 prod(Render)
ENV=dev

# 비워 두면 내 컴퓨터의 SQLite 파일(dev.db)을 쓴다.
# Neon 대시보드의 Connection string을 붙여 넣는다. 끝에 ?sslmode=require 가 있어야 한다.
DATABASE_URL=

# 길고 무작위인 문자열. 만들기: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# 캠퍼스 중심 좌표와 가입 허용 반경(m)
CAMPUS_LAT=36.33716
CAMPUS_LNG=127.44536
CAMPUS_RADIUS_M=400

# 공지 푸시 알림 서명 키 (비워 두면 알림 기능이 꺼진다)
# 만들기: .venv/Scripts/python make_vapid.py  → 출력된 두 줄을 여기에 붙여 넣기
# 비밀키(VAPID_PRIVATE_KEY)는 절대 Git에 올리지 않는다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:lead@dotci.co.kr
